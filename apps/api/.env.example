PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=study_user
DB_PASSWORD=your_password
DB_NAME=study_system
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Piper 本地 TTS（Windows 示例路径，按实际修改）
PIPER_BIN=C:\SOFT\tools\piper\piper.exe
PIPER_VOICES_DIR=C:\SOFT\tools\piper\voices
PIPER_DEFAULT_VOICE=en_GB-alba-medium
# 兼容单模型写法（可选）：
# PIPER_MODEL=C:\SOFT\tools\piper\voices\en_GB-alba-medium.onnx
# PIPER_SPEAKER=0
# PIPER_TIMEOUT_MS=120000

# AI 参考（DeepSeek + 图片识别）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推荐 deepseek-chat（稳定返回 JSON）。deepseek-flash 会先长推理，易截断导致「未返回有效 JSON」
DEEPSEEK_MODEL=deepseek-chat
# 错题 / AI参考 / 写作教练 · 图片转写引擎（默认 Qwen Vision）
# vision | local | vision_then_local | local_then_vision
OCR_ENGINE=vision
# 可单独配置；留空则回退使用下方 HS_MATH_VISION_*
# OCR_VISION_API_URL=
# OCR_VISION_API_KEY=
# OCR_VISION_MODEL=qwen3.8-27b
# OCR_VISION_TIMEOUT_MS=90000
# 本机 Paddle（OCR_ENGINE=local 或 *_then_local 时需要）
OCR_BASE_URL=http://127.0.0.1:9100
# 公式 / 智能 OCR（Pix2Text 独立服务，与 Paddle 分 venv）
OCR_FORMULA_BASE_URL=http://127.0.0.1:9101
AI_SIMILAR_DAILY_LIMIT=30
# 电子宠物对话日限
PET_CHAT_DAILY_LIMIT=40

# 高一数学 · 文字 AI 批改（默认关闭；与 Vision 独立）
HS_MATH_AI_GRADING_ENABLED=false

# 高一数学 · Qwen Vision 多模态批改（默认关闭；禁止前端传入 URL）
HS_MATH_VISION_GRADING_ENABLED=false
HS_MATH_VISION_API_URL=
HS_MATH_VISION_API_KEY=
HS_MATH_VISION_MODEL=qwen3.8-27b
# 进程内同时进行的 Vision HTTP 上限（默认 2；不建任务队列）
# HS_MATH_VISION_MAX_INFLIGHT=2
# APPLICATION-3D-9 真实验收 fail-closed（TEST_USER 有值且 SESSION 空 → 禁止外发）
# HS_MATH_VISION_GRADING_TEST_USER_ID=2
# HS_MATH_VISION_GRADING_TEST_SESSION_IDS=
# HS_MATH_VISION_GRADING_TEST_SESSION_ITEM_IDS=
# HS_MATH_VISION_LIVE_HTTP_BUDGET=2
# HS_MATH_AI_GRADING_LIVE_HTTP_BUDGET=5

# APPLICATION-4C-4D：日常应用题 AI（示例默认关闭；正式启用见本地 .env / 111 报告）
# HS_MATH_APPLICATION_AI_MODE=owner_only
# HS_MATH_APPLICATION_AI_ALLOWED_USER_IDS=2
# HS_MATH_DEEPSEEK_DAILY_LIMIT=20
# 注意：示例文件保持开关 false；勿把密钥提交仓库
