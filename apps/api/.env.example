PORT=3000
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=study_user
DB_PASSWORD=your_password
DB_NAME=study_system
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Piper 本地 TTS（Windows 示例路径，按实际修改）
PIPER_BIN=C:\SOFT\tools\piper\piper.exe
PIPER_VOICES_DIR=C:\SOFT\tools\piper\voices
PIPER_DEFAULT_VOICE=en_GB-alba-medium
# 兼容单模型写法（可选）：
# PIPER_MODEL=C:\SOFT\tools\piper\voices\en_GB-alba-medium.onnx
# PIPER_SPEAKER=0
# PIPER_TIMEOUT_MS=120000

# AI 参考（DeepSeek + 本地 PaddleOCR）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# 推荐 deepseek-chat（稳定返回 JSON）。deepseek-flash 会先长推理，易截断导致「未返回有效 JSON」
DEEPSEEK_MODEL=deepseek-chat
OCR_BASE_URL=http://127.0.0.1:9100
# 公式 / 智能 OCR（Pix2Text 独立服务，与 Paddle 分 venv）
OCR_FORMULA_BASE_URL=http://127.0.0.1:9101
AI_SIMILAR_DAILY_LIMIT=30
# 电子宠物对话日限
PET_CHAT_DAILY_LIMIT=40
