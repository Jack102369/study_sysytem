    {
      "type": "question",
      "data": {
        "qtype": "short",
        "stem": "（骨架）写出乙酸与乙醇酯化的化学方程式（标明条件与可逆），并说明浓硫酸的作用。",
        "answer": "CH3COOH+C2H5OH⇌浓硫酸、加热⇌CH3COOC2H5+H2O；浓硫酸作催化剂并吸水（促进平衡）。",
        "analysis": "酯化可逆；条件与规律为得分点。",
        "scoring": "方程式+条件+浓硫酸作用要点。",
        "difficulty": 2,
        "status": "pending_review",
        "reviewNote": "[inv:q.organic.ester] 骨架非正式训练题"
      }
    },
    {
      "type": "question",
      "data": {
        "qtype": "short",
        "stem": "（骨架）写出分子式为C4H10的烷烃的同分异构体结构简式（要求不重复）。",
        "answer": "CH3CH2CH2CH3；CH3CH(CH3)CH3（正丁烷与异丁烷）",
        "analysis": "碳链异构两种；检查重复。",
        "scoring": "两种均写出且不重复得分。",
        "difficulty": 2,
        "status": "pending_review",
        "reviewNote": "[inv:q.organic.isomer] 骨架非正式训练题;基础书写"
      }
    },
    {
      "type": "question",
      "data": {
        "qtype": "inference",
        "stem": "（骨架）某无机框图：A为淡黄色固体单质，燃烧得气体B；B使品红褪色且加热可恢复。推断A、B（写化学式）并给出关键依据。",
        "answer": "A为S；B为SO2（依据：淡黄色单质硫；SO2漂白可逆恢复）",
        "analysis": "颜色+漂白可逆是突破口；需用转化验证。",
        "scoring": "物质正确+依据要点。",
        "difficulty": 2,
        "status": "pending_review",
        "reviewNote": "[inv:q.inference.block] 骨架非正式训练题;框图模板"
