    {
      "type": "question",
      "data": {
        "qtype": "judge",
        "stem": "（骨架）判断：乙烯能使溴水褪色，该反应属于加成反应。",
        "answer": "正确",
        "analysis": "CH2=CH2+Br2→CH2BrCH2Br，为加成，溴水褪色。",
        "scoring": "判断正确得分。",
        "difficulty": 1,
        "status": "pending_review",
        "reviewNote": "[inv:q.organic.ethene] 骨架非正式训练题"
      }
    },
    {
      "type": "question",
      "data": {
        "qtype": "blank",
        "stem": "（骨架）乙醇催化氧化常用______或______作催化剂并加热，产物乙醛的化学式为______。",
        "answer": "Cu；Ag；CH3CHO",
        "analysis": "教材常见Cu或Ag催化加热；2CH3CH2OH+O2→2CH3CHO+2H2O。",
        "scoring": "催化剂与产物均对得分。",
        "difficulty": 2,
        "status": "pending_review",
        "reviewNote": "[inv:q.organic.ethanol] 骨架非正式训练题"
