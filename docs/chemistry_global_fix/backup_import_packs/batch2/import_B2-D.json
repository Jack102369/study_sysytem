{
  "items": [
    {
      "type": "knowledge",
      "data": {
        "name": "氧化产物判断",
        "description": "氧化产物是还原剂被氧化后的产物（化合价升高后的产物）。判断：找化合价升高的元素，其对应产物为氧化产物。例：2Na+Cl2=2NaCl中，NaCl对钠而言是氧化产物。易错：把氧化剂当成氧化产物。",
        "difficulty": 2,
        "importance": 4,
        "status": "pending_review",
        "reviewNote": "[inv:kp.redox.ox_product] parent=kp.redox"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "还原产物判断",
        "description": "还原产物是氧化剂被还原后的产物（化合价降低后的产物）。例：同上反应中NaCl对氯而言是还原产物。易错：名称对调。",
        "difficulty": 2,
        "importance": 4,
        "status": "pending_review",
        "reviewNote": "[inv:kp.redox.re_product] parent=kp.redox"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "电子转移",
        "description": "氧化还原的本质是电子转移（或共用电子对偏移）。可用双线桥/单线桥表示电子转移方向与数目。易错：只看氧元素是否参加。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.redox.e_transfer] parent=kp.redox"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "电子守恒",
        "description": "电子守恒：失电子总数=得电子总数，用于配平与计算。易错：只配平原子个数。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.redox.e_conserve] parent=kp.redox"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "电解质与非电解质",
        "description": "电解质：在水溶液中或熔融状态下能够导电的化合物。非电解质：在上述条件下都不能导电的化合物。注意：单质（如金属、石墨）既不是电解质也不是非电解质；二氧化碳、二氧化硫等本身是非电解质，其水溶液导电是因与水反应生成了电解质。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.ion.electrolyte] B2整改:补完整定义与单质边界"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "电离方程式书写",
        "description": "电离方程式书写：强电解质完全电离用“=”，弱电解质用“⇌”；注意原子守恒与电荷守恒；多元弱酸分步电离。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.ion.ionization_eq]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "离子共存判断",
        "description": "离子共存：检查沉淀、气体、水、氧化还原、弱电解质生成。注意题设酸碱性与颜色。",
        "difficulty": 3,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.ion.coexist]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "离子方程式书写",
        "description": "离子方程式：强电解质（易溶强酸强碱盐）拆成离子，沉淀、气体、弱电解质、单质、氧化物等不拆；删去旁观离子；检查原子守恒与电荷守恒。边界：微溶物是否拆、酸式盐拆分、少量/过量反应产物，以题设与课本规则为准，不可僵化。",
        "difficulty": 3,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.ion.ionic_eq] B2整改:补微溶/过量/酸式盐边界提示"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "原子组成与三粒子",
        "description": "原子组成：质子数=核电荷数=原子序数；质量数 A = 质子数 Z + 中子数 N（定义用等号，不是近似）；核外电子数=质子数（原子）。注意：质量数是整数，相对原子质量是加权平均值，二者不可混淆。离子的电子数随所带电荷变化。",
        "difficulty": 1,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.structure.atom] P0已修:质量数改用A=Z+N等号，区分相对原子质量"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "核素与同位素",
        "description": "核素：具有一定质子数和中子数的原子；同位素：质子数相同中子数不同的同一元素不同核素。化学性质几乎相同。",
        "difficulty": 2,
        "importance": 4,
        "status": "pending_review",
        "reviewNote": "[inv:kp.structure.isotope]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "化学键类型判断",
        "description": "离子键与共价键判断：活泼金属+活泼非金属倾向离子键；非金属之间倾向共价键。结合物质类别综合判断。",
        "difficulty": 2,
        "importance": 4,
        "status": "pending_review",
        "reviewNote": "[inv:kp.structure.bond]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "电子式书写",
        "description": "电子式：用“·”表示原子最外层电子。简单阳离子（如Na⁺、Ca²⁺）一般只写离子符号不画电子；阴离子与复杂阳离子（如NH₄⁺）需按规定画出电子式并标注电荷/括号。",
        "difficulty": 3,
        "importance": 4,
        "status": "pending_review",
        "reviewNote": "[inv:kp.structure.electron_formula] B2整改:区分简单/复杂阳离子"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "周期与族定位",
        "description": "周期数=电子层数；主族序数=最外层电子数（主族）。由原子序数推电子排布再定位。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.periodic.position]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "核外电子排布",
        "description": "核外电子排布：先内后外，每层最多2n^2；最外层不超过8，次外层不超过18（高中规则）。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.periodic.e_config]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "周期律递变规律",
        "description": "同周期（从左到右，主族）：金属性减弱、非金属性增强，原子半径一般减小，最高正化合价与族序相关。同主族（从上到下）：金属性增强、非金属性减弱，原子半径增大。比较方法：与水/酸反应难易、最高价氧化物对应水化物酸碱性、气态氢化物稳定性、单质氧化性等（限主族教学口径）。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.periodic.trend] B2整改:补具体递变方向与比较方法"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "物质的量三公式",
        "description": "物质的量三公式：n=m/M；n=N/NA；仅当气体处于标准状况时可用 n=V/22.4（V单位L）。先判断已知量与条件再选式；非标况气体不可用22.4。",
        "difficulty": 1,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.calc.amount] B2整改:强调非标况不可用22.4"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "物质的量浓度",
        "description": "c=n/V，注意溶液体积单位为L；与质量分数、密度换算要分步。",
        "difficulty": 2,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.calc.concentration]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "稀释计算",
        "description": "稀释前后溶质n不变：c1V1=c2V2。混合若反应则不能直接套用。",
        "difficulty": 2,
        "importance": 4,
        "status": "pending_review",
        "reviewNote": "[inv:kp.calc.dilution]"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "常见化合价速记",
        "description": "常见化合价速记：K/Na +1；Ca/Mg/Ba/Zn +2；Al +3；Fe +2/+3；Cu +1/+2；H 多为+1（氢化物中可为−1）；F −1；O 通常−2（过氧化物中为−1）；Cl 常见−1；N 常见−3/+2/+4/+5（及+1/+3等）。注意硝酸等含氮化合物价态需按规则计算。",
        "difficulty": 1,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.memory.valence_table] B2整改:补Fe/Cu/H等变价"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "常见离子速记",
        "description": "常见离子速记：NH₄⁺、OH⁻、NO₃⁻、SO₄²⁻、CO₃²⁻、Cl⁻、S²⁻、Ba²⁺、Ag⁺、Fe²⁺、Fe³⁺、Cu²⁺、Al³⁺等；电荷写在右上角。检验与共存题常考上述离子。",
        "difficulty": 1,
        "importance": 5,
        "status": "pending_review",
        "reviewNote": "[inv:kp.memory.ion_table] B2整改:补Fe²⁺/Ag⁺/S²⁻等"
      }
    },
    {
      "type": "knowledge",
      "data": {
        "name": "物质颜色速记",
        "description": "必修常见颜色：Cl₂黄绿；Br₂深红棕；I₂紫黑；Cu²⁺溶液蓝色；Fe²⁺溶液浅绿；Fe³⁺溶液黄/棕黄；Fe(OH)₂白色（易氧化）；Fe(OH)₃红褐；Cu(OH)₂蓝色。MnO₄⁻紫红偏拓展，训练中宜标注了解/非默认必修表。",
        "difficulty": 2,
        "importance": 3,
        "status": "pending_review",
        "reviewNote": "[inv:kp.memory.color_table] B2整改:补卤素与Fe²⁺，MnO₄⁻标拓展"
      }
    }
  ],
