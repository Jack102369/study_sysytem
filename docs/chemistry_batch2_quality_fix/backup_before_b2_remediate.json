    "concept.elemental_compound": {
      "id": 4,
      "name": "单质与化合物",
      "definition": "单质由同种元素组成；化合物由不同种元素组成。",
      "principle": "元素是具有相同核电荷数（质子数）的一类原子的总称；单质是元素的游离态形式之一。",
      "applicable_conditions": "讨论物质组成时。",
      "judge_methods": "看化学式中元素种类数。",
      "examples": "O2、金刚石是单质；CO2、NaCl是化合物。",
      "common_mistakes": "把O2与O混淆；把CO当成单质。注意：Co是钴单质相关元素，CO是一氧化碳化合物。",
      "status": "pending_review",
      "review_note": "[inv:concept.elemental_compound]",
      "created_by": 2,
      "updated_by": 2,
      "reviewed_by": null,
      "reviewed_at": null,
      "created_at": "2026-10-18T03:38:21.053Z",
      "updated_at": "2026-10-18T03:38:21.053Z"
    },
    "concept.charge_conserve": {
      "id": 20,
      "name": "电荷守恒",
      "definition": "离子反应或氧化还原过程中，体系电荷守恒：反应前后离子电荷总数相等。",
      "principle": "配平离子方程式必须满足电荷守恒。",
      "applicable_conditions": "离子方程式、氧化还原配平。",
      "judge_methods": "检查离子方程式左右电荷代数和。",
      "examples": "2H++CO32-=CO2↑+H2O。",
      "common_mistakes": "只顾原子守恒不顾电荷守恒。",
      "status": "pending_review",
      "review_note": "[inv:concept.charge_conserve]",
      "created_by": 2,
