    {
      "candidateCode": "CAND-G1B-080",
      "itemId": 231,
      "stem": "用向量证明：平行四边形对角线互相平分（设 $\\vec{AB}=\\vec a$，$\\vec{AD}=\\vec b$）。",
      "options": null,
      "answer": {
        "kind": "application",
        "rubric": [
          {
            "key": "diag",
            "title": "对角线",
            "criteria": "$\\vec a+\\vec b$",
            "maxScore": 4
          },
          {
            "key": "mid",
            "title": "中点",
            "criteria": "平分",
            "maxScore": 4
          },
          {
            "key": "cl",
            "title": "表述",
            "criteria": "清晰",
            "maxScore": 2
          }
        ],
        "maxScore": 10,
        "standardAnswer": "对角线交点对应向量为 $\\frac{\\vec a+\\vec b}{2}$，即中点。"
      },
      "analysis": "设 $\\vec{AB}=\\vec a$，$\\vec{AD}=\\vec b$。对角线 $\\vec{AC}=\\vec a+\\vec b$，中点满足 $\\vec{AM}=\\dfrac12(\\vec a+\\vec b)$；另一对角线中点同样为 $\\dfrac{\\vec a+\\vec b}{2}$。交点重合，故互相平分。",
      "difficulty": 3,
      "contentVersion": 1,
      "status": "approved",
      "pool": "formal",
      "isActive": 1,
      "qtype": "application"
    },
