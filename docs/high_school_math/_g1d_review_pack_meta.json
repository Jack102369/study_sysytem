            "maxScore": 4
          },
          {
            "key": "calc",
            "title": "计算",
            "criteria": "$40\\sqrt3/3$",
            "maxScore": 4
          },
          {
            "key": "u",
            "title": "单位",
            "criteria": "m",
            "maxScore": 2
          }
        ],
        "maxScore": 10,
        "standardAnswer": "$h=\\dfrac{40\\sqrt3}{3}\\text{m}$。"
      },
      "analysis": "直角三角形中，仰角 $30^\\circ$，邻边（水平距离）为 $40$，对边为塔高 $h$。故 $h=40\\tan30^\\circ=40\\cdot\\dfrac{\\sqrt3}{3}=\\dfrac{40\\sqrt3}{3}\\text{m}$。",
      "difficulty": 3,
      "contentVersion": 2,
      "status": "draft",
