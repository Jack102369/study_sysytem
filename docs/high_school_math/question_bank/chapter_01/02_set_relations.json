    },
    {
      "code": "HSMA-RJA-CH01-0032",
      "specialtyCode": "rja-ch1",
      "categoryCode": "1.2",
      "qtype": "numeric",
      "difficulty": 3,
      "stem": "若集合 $A$ 的子集共有 $16$ 个，则 $A$ 的元素个数是",
      "answerPayload": {
