    {
      "code": "HSMA-RJA-CH01-0014",
      "specialtyCode": "rja-ch1",
      "categoryCode": "1.1",
      "qtype": "judge",
      "difficulty": 1,
      "stem": "用描述法表示集合时，必须写清代表元素所属的范围（或约定默认范围）。",
